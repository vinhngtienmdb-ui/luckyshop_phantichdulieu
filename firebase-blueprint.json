{
  "entities": {
    "Config": {
      "title": "Application Configuration",
      "description": "System-wide payout rates and limits",
      "type": "object",
      "properties": {
        "a_max_tgd": { "type": "number" },
        "a_max_gd": { "type": "number" },
        "a_max_ql": { "type": "number" },
        "a_max_nv": { "type": "number" },
        "a_max_direct": { "type": "number" },
        "a_max_indirect": { "type": "number" },
        "p_b_rate1": { "type": "number" },
        "p_b_rate2": { "type": "number" },
        "p_b_rate3": { "type": "number" },
        "p_b_rate4": { "type": "number" },
        "p_b_rate5": { "type": "number" },
        "p_b_rate6": { "type": "number" },
        "p_b_rate7": { "type": "number" }
      },
      "required": [
        "a_max_tgd",
        "a_max_gd",
        "a_max_ql",
        "a_max_nv",
        "a_max_direct",
        "a_max_indirect",
        "p_b_rate1",
        "p_b_rate2",
        "p_b_rate3",
        "p_b_rate4",
        "p_b_rate5",
        "p_b_rate6",
        "p_b_rate7"
      ]
    },
    "User": {
      "title": "User Account Profile",
      "description": "User specific credentials, lucky balances, and warning thresholds",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "isProfileComplete": { "type": "boolean" },
        "luckyShopAccount": { "type": "string" },
        "luckyShopAccounts": { "type": "array" },
        "luckyShopTeam": { "type": "string" },
        "currentLuckyBalance": { "type": "number" },
        "luckyLimit": { "type": "number" }
      },
      "required": [
        "email",
        "role",
        "status"
      ]
    },
    "Product": {
      "title": "Product Entity",
      "description": "A saved product with a name and price for easy calculations",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": [
        "name",
        "price"
      ]
    },
    "AgriProduct": {
      "title": "Agricultural Product Entity",
      "description": "A saved agricultural product with name, marketPrice, promoPrice, and bulk configurations",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "marketPrice": { "type": "number" },
        "promoPrice": { "type": "number" },
        "bulkBuy": { "type": "number" },
        "bulkGift": { "type": "number" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": [
        "name",
        "marketPrice",
        "promoPrice"
      ]
    },
    "AgriState": {
      "title": "Agricultural Simulation State",
      "description": "State for simulated VN agricultural market sandbox",
      "type": "object",
      "properties": {
        "cash": { "type": "number" },
        "lixi": { "type": "number" },
        "points": { "type": "number" },
        "holdings": { "type": "array" },
        "listedItems": { "type": "array" },
        "f1Network": { "type": "array" },
        "simulatedDateString": { "type": "string" }
      },
      "required": [
        "cash",
        "lixi",
        "points"
      ]
    }
  },
  "firestore": {
    "/configs/{configId}": {
      "schema": "Config",
      "description": "Global configuration documents"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User details, balance thresholds and status codes"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Product catalog entries"
    },
    "/agri_products/{productId}": {
      "schema": "AgriProduct",
      "description": "Agricultural product catalog entries"
    },
    "/agri_states/{userId}": {
      "schema": "AgriState",
      "description": "Simulation state for the VN Agricultural module per user"
    }
  }
}
